# --- Booking payments ---
# request (default) = clients send a booking request and pay the deposit by M-Pesa themselves;
#                     you confirm each deposit on /admin. No Safaricom approval or VPS needed.
# mpesa             = automatic M-Pesa prompt (Daraja). Only once Go Live is approved and the server is public HTTPS.
BOOKING_PAYMENTS=request

# --- Site ---
SITE_URL=http://localhost:3000
# Artist dashboard (/admin). Use a password only you know (8+ characters).
ADMIN_PASSWORD=change-me-to-a-strong-password
# Long random string used to sign login cookies (16+ characters). Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- M-Pesa (Safaricom Daraja) ---
# mock    = no Safaricom calls; payments are simulated (default for local dev)
# sandbox = Daraja sandbox (needs the keys below)
# live    = real money
MPESA_ENV=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Long random string. It becomes part of the callback URL so strangers can't forge payment callbacks.
MPESA_CALLBACK_SECRET=change-me-too

# Supabase (database and photo storage). Copy from Project Settings -> API.
# The secret key bypasses Row Level Security: keep it on the server only, never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
